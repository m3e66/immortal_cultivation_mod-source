    {
      "type": "patchouli:text",
      "title": "《百草录》记载",
      "text": "玄冰莲乃寒地灵植，受冰雪精气滋养，花瓣晶莹如玉。其内寒气凝而不散，虽处风雪之中，依旧静静盛放。世人见其出于冰封绝境，常以之象征清心守志。"
    },
    {
      "type": "patchouli:text",
      "title": "寻药",
      "text": "雪原、雪坡、冰刺原、冰封河流、冰封海洋及冰封山峰。"
    }
  ]
}
